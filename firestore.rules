rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserProfile() {
      return isSignedIn() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : null;
    }

    function currentUserRole() {
      return isSignedIn() ? currentUserProfile().role : null;
    }

    function isActiveUser() {
      return isSignedIn() && currentUserProfile().status == 'ACTIVE';
    }

    function isOwner() {
      return isActiveUser() && currentUserRole() == 'OWNER';
    }

    function isAppAdmin() {
      return isActiveUser() && currentUserRole() == 'APP_ADMIN';
    }

    function isNonNegativeCutOffGradeValue(value) {
      return (value is int || value is float) && value >= 0;
    }

    function validCutOffGradeNi(data) {
      return data.keys().hasAll([
          'saprolitHGMin',
          'saprolitLGMin',
          'saprolitLGMax',
          'limonitOreMin',
          'limonitOreMax',
          'wasteOBMax',
          'updatedAt',
          'updatedBy'
        ])
        && data.keys().hasOnly([
          'saprolitHGMin',
          'saprolitLGMin',
          'saprolitLGMax',
          'limonitOreMin',
          'limonitOreMax',
          'wasteOBMax',
          'updatedAt',
          'updatedBy'
        ])
        && isNonNegativeCutOffGradeValue(data.saprolitHGMin)
        && isNonNegativeCutOffGradeValue(data.saprolitLGMin)
        && isNonNegativeCutOffGradeValue(data.saprolitLGMax)
        && isNonNegativeCutOffGradeValue(data.limonitOreMin)
        && isNonNegativeCutOffGradeValue(data.limonitOreMax)
        && isNonNegativeCutOffGradeValue(data.wasteOBMax)
        && data.wasteOBMax <= data.limonitOreMin
        && data.limonitOreMin <= data.limonitOreMax
        && data.limonitOreMax < data.saprolitLGMin
        && data.saprolitLGMin <= data.saprolitLGMax
        && data.saprolitLGMax < data.saprolitHGMin
        && data.updatedAt is timestamp
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid;
    }

    function validAccountStatus(status) {
      return status in ['ACTIVE', 'DISABLED'];
    }

    function ownerCanUpdateManagedAccount() {
      return isOwner()
        && resource.data.role in ['USER', 'APP_ADMIN']
        && request.resource.data.role in ['USER', 'APP_ADMIN']
        && validAccountStatus(request.resource.data.status)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'status', 'updatedAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status']);
    }

    function appAdminCanUpdateUserStatus() {
      return isAppAdmin()
        && resource.data.role == 'USER'
        && request.resource.data.role == 'USER'
        && validAccountStatus(request.resource.data.status)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']);
    }

    function isOwnProfile(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow get: if isOwnProfile(uid)
        || isOwner()
        || (isAppAdmin() && resource.data.role == 'USER');

      allow list: if isOwner()
        || (isAppAdmin() && resource.data.role == 'USER');

      allow create: if false;
      allow update: if ownerCanUpdateManagedAccount()
        || appAdminCanUpdateUserStatus();
      allow delete: if false;
    }

    match /appSettings/cutOffGradeNi {
      allow get: if isActiveUser()
        && currentUserRole() in ['OWNER', 'APP_ADMIN', 'USER'];
      allow create, update: if (isOwner() || isAppAdmin())
        && validCutOffGradeNi(request.resource.data);
      allow list, delete: if false;
    }

    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
