rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserProfile() {
      return isSignedIn() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : null;
    }

    function currentUserRole() {
      return isSignedIn() ? currentUserProfile().role : null;
    }

    function isActiveUser() {
      return isSignedIn() && currentUserProfile().status == 'ACTIVE';
    }

    function isOwner() {
      return isActiveUser() && currentUserRole() == 'OWNER';
    }

    function isAppAdmin() {
      return isActiveUser() && currentUserRole() == 'APP_ADMIN';
    }

    function validAccountStatus(status) {
      return status in ['ACTIVE', 'DISABLED'];
    }

    function ownerCanUpdateManagedAccount() {
      return isOwner()
        && resource.data.role in ['USER', 'APP_ADMIN']
        && request.resource.data.role in ['USER', 'APP_ADMIN']
        && validAccountStatus(request.resource.data.status)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'status', 'updatedAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status']);
    }

    function appAdminCanUpdateUserStatus() {
      return isAppAdmin()
        && resource.data.role == 'USER'
        && request.resource.data.role == 'USER'
        && validAccountStatus(request.resource.data.status)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']);
    }

    function isOwnProfile(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow get: if isOwnProfile(uid)
        || isOwner()
        || (isAppAdmin() && resource.data.role == 'USER');

      allow list: if isOwner()
        || (isAppAdmin() && resource.data.role == 'USER');

      allow create: if false;
      allow update: if ownerCanUpdateManagedAccount()
        || appAdminCanUpdateUserStatus();
      allow delete: if false;
    }

    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
